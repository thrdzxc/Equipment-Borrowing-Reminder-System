{
  "name": "uls/equipment-borrowing-reminder-api",
  "type": "project",
  "description": "Week 13 Laravel REST API for Equipment Borrowing Reminder System",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "test": ["@php artisan test"]},
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": true}}
}
