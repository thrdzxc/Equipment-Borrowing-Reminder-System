APP_NAME="Equipment Borrowing Reminder API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=single
LOG_LEVEL=info
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FRONTEND_ORIGIN=http://localhost:3000
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=CHANGE_ME_LOCALLY
# For a hosted deployment use HTTPS and a trusted TLS reverse proxy.
SECURE_REQUIRE_HTTPS=false
TOKEN_TTL_MINUTES=60
# Optional fictional-data accounts for role checks (12+ characters, local only)
DEMO_STAFF_EMAIL=staff@example.test
DEMO_STAFF_PASSWORD=CHANGE_ME_LOCALLY
DEMO_STUDENT_EMAIL=student@example.test
DEMO_STUDENT_PASSWORD=CHANGE_ME_LOCALLY
